# Storefront API (канал Headless у Shopify). Токен публічний, але в git його все одно не кладемо
NUXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NUXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
